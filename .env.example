# Generate a secret with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret
# Local default is SQLite. For deployment, set DATABASE_URL to a PostgreSQL URL.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/trustvault
# Set these only to bootstrap the first admin account. Remove them after setup if appropriate.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-chars
# UPLOAD_FOLDER=/absolute/path/to/private_uploads
# COOKIE_SECURE=true
# FLASK_DEBUG=false
