[32m+[m[32m    actor = actor if actor is not None else (current_user if current_user.is_authenticated else None)[m
[32m+[m[32m    previous = db.session.query(AuditEvent).order_by(AuditEvent.id.desc()).first()[m
[32m+[m[32m    previous_hash = previous.event_hash if previous else "0" * 64[m
[32m+[m[32m    event_time = utcnow()[m
[32m+[m[32m    payload = {[m
[32m+[m[32m        "occurred_at": event_time.isoformat(),[m
[32m+[m[32m        "actor_id": actor.id if actor else None,[m
[32m+[m[32m        "actor_email": actor.email if actor else "anonymous",[m
[32m+[m[32m        "action": action,[m
[32m+[m[32m        "document_id": document_id,[m
[32m+[m[32m        "target_user_id": target_user_id,[m
[32m+[m[32m        "outcome": outcome,[m
[32m+[m[32m        "details": details or {},[m
[32m+[m[32m        "previous_hash": previous_hash,[m
[32m+[m[32m    }[m
[32m+[m[32m    canonical = json.dumps(payload, sort_keys=True, separators=(",", ":"))[m
[32m+[m[32m    event_hash = hashlib.sha256(canonical.encode("utf-8")).hexdigest()[m
[32m+[m[32m    event = AuditEvent([m
[32m+[m[32m        occurred_at=event_time, actor_id=payload["actor_id"], actor_email=payload["actor_email"], action=action,[m
[32m+[m[32m        document_id=document_id, target_user_id=target_user_id, outcome=outcome,[m
[32m+[m[32m        details=json.dumps(details or {}, sort_keys=True), previous_hash=previous_hash, event_hash=event_hash,[m
[32m+[m[32m    )[m
[32m+[m[32m    db.session.add(event)[m
[32m+[m[32m    db.session.flush()[m
[32m+[m[32m    return event[m
