[32m+[m[32m        if event_time.tzinfo is None:[m
[32m+[m[32m            event_time = event_time.replace(tzinfo=timezone.utc)[m
[32m+[m[32m        payload = {[m
[32m+[m[32m            "occurred_at": event_time.isoformat(),[m
[32m+[m[32m            "actor_id": event.actor_id,[m
[32m+[m[32m            "actor_email": event.actor_email,[m
[32m+[m[32m            "action": event.action,[m
[32m+[m[32m            "document_id": event.document_id,[m
[32m+[m[32m            "target_user_id": event.target_user_id,[m
[32m+[m[32m            "outcome": event.outcome,[m
[32m+[m[32m            "details": json.loads(event.details or "{}"),[m
[32m+[m[32m            "previous_hash": previous_hash,[m
[32m+[m[32m        }[m
